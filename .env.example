DATABASE_URL=postgres://vox:vox@localhost:5432/vox_content_os
KIMI_API_KEY=
N8N_BASE_URL=http://localhost:5678
DRY_RUN_ONLY=true
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
SQLITE_PATH=./data/vox-content-os.sqlite
OPENCLI_BIN=/absolute/path/to/opencli
AGENT_REACH_BIN=/absolute/path/to/agent-reach

# Local social publishing bridge
SOCIAL_PUBLISH_ACCOUNT=vox
WECHATSYNC_BIN=/opt/homebrew/bin/wechatsync
# Optional override; default resolves to project .venv-sau/bin/sau
SAU_BIN=
# Generate this in the Wechatsync Chrome extension; never commit the real token.
WECHATSYNC_TOKEN=

# Google Drive content archive (OAuth; refresh token recommended)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional short-lived token for testing only.
GOOGLE_DRIVE_ACCESS_TOKEN=
# Optional existing destination folder; otherwise app creates "VOX Content OS 归档" in My Drive.
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=
GOOGLE_DRIVE_ARCHIVE_FOLDER_NAME=VOX Content OS 归档
